<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Downloads the patch (or the full APK) from GitHub. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Hands the rebuilt APK to Android's installer (Rex still taps Install each time). Nothing else. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- The apps it updates: it reads their version and their installed APK (the patch's starting point). -->
    <queries>
        <package android:name="com.xarvis.ai" />
        <package android:name="com.xarvis.remote" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.Light">
        <!-- What this build is made from (see sourceFingerprint in build.gradle.kts): unchanged = no update needed. -->
        <meta-data
            android:name="xarvis.src"
            android:value="${xarvisSrc}" />
        <activity
            android:name=".UpdaterActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Android's answer about an install (needs Rex's tap / installed / failed). -->
        <receiver
            android:name=".InstallReceiver"
            android:exported="false" />
    </application>
</manifest>
