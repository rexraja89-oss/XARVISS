<?xml version="1.0" encoding="utf-8"?>
<!-- S22 build only: XARVIS Hands and XARVIS Eyes built into the main app. The S22 accepted this in
     Nov 2026 (install test release test-allinone-v1.0.184); in Oct 2026 it had refused an
     Accessibility service in the main app. The benco build stays without them. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- XARVIS Eyes: the live camera (☰ → XARVIS Eyes, or "look"). Asked for the first time it's used. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Remote camera with the screen off: the benco's photo request wakes the S22 like an incoming call
         and opens Eyes over the lock screen (RemoteCameraNotice). Normal permission on Android 13. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Remote control by the linked phone (ScreenHost): wakes the screen and keeps it on while in use. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Smooth remote control: screen sharing (Android's "Start now" prompt) into the video encoder. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Android 14+ (the S22 after its One UI update): the background microphone ("Xarvis") and camera (Watch mode)
         services each need their own permission. Left out of the Android 13 builds because the S22 refused to
         install XARVIS with FOREGROUND_SERVICE_MICROPHONE while it was on 13. Normal permissions: no prompt. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- Guard mode: Rex's fingerprint (only) ends the intruder alarm. Normal permission. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application>
        <!-- XARVIS Eyes: camera view; one photo at a time goes to Gemma, nothing is saved. -->
        <activity
            android:name=".EyesActivity"
            android:exported="false"
            android:label="XARVIS Eyes"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.DeviceDefault.Light" />

        <!-- Guard mode: the front-camera check, the red intruder alarm and the fingerprint (over the lock screen). -->
        <activity
            android:name=".GuardActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <!-- Smooth remote control: Android's screen-sharing prompt, and the service that holds the permission. -->
        <activity
            android:name=".hands.ScreenConsentActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <service
            android:name=".hands.ScreenShareService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- XARVIS Hands: taps inside other apps (imo/WhatsApp calls) when Rex asks. Exported is
             required for Settings to list it; only the system can bind it (BIND_ACCESSIBILITY_SERVICE). -->
        <service
            android:name=".hands.XarvisHandsService"
            android:exported="true"
            android:label="XARVIS Hands"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/xarvis_accessibility_config" />
        </service>
        <!-- Watch mode: the front camera watches the room with the screen off (Android 13: no extra permission). -->
        <service
            android:name=".watch.WatchService"
            android:exported="false"
            android:foregroundServiceType="camera" />
    </application>
</manifest>
