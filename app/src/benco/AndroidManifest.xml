<?xml version="1.0" encoding="utf-8"?>
<!--
  The benco rejects sideloaded apps that can place calls ("package appears to be invalid"), and
  it rejected v1.0.81 too, which had added the microphone permission, "Hey Jarvis" (TensorFlow
  Lite) and the own-voice engine. This build leaves all of those out; the mic button still works
  through Google's speech screen, which needs no permission.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.CALL_PHONE" tools:node="remove" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <!-- The benco is install-sensitive and has no XARVIS Hands; keep this off it. -->
    <uses-permission android:name="com.xarvis.hands.permission.COMMAND" tools:node="remove" />
    <application>
        <service android:name=".service.WakeWordService" tools:node="remove" />
        <activity android:name=".RecordVoiceActivity" tools:node="remove" />
    </application>
</manifest>
